<UserControl x:Class="SaniStock.App.Views.OrderDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Send Order" Style="{StaticResource H1}" />
            <TextBlock Text="Pick an order on the left, type how many to send, then press Send Now." Style="{StaticResource Muted}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Open orders -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Orders to Send" Style="{StaticResource H2}" DockPanel.Dock="Left" />
                        <Button Content="⟳ Refresh" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,4" />
                    </DockPanel>
                    <!-- No two-way SelectedItem binding: the grid's global style uses cell-level
                         selection (for single-value clipboard copy), so a plain click only selects
                         a cell, not the row, and SelectedItem never updates. CurrentCell tracks the
                         clicked cell regardless of selection unit, so we read the order from it. -->
                    <DataGrid x:Name="OpenOrdersGrid" ItemsSource="{Binding OpenOrders}"
                              SelectedCellsChanged="OpenOrdersGrid_SelectedCellsChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="*" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding Party}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Dispatch panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding DispatchDate}" Width="150" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Send All" VerticalAlignment="Bottom"
                                Command="{Binding DispatchAllPendingCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Content="🚚  Send Now" Command="{Binding DispatchCommand}"
                            Style="{StaticResource PrimaryButton}" Height="46" Width="200" FontSize="15"
                            HorizontalAlignment="Right" Margin="0,12,0,0" />

                    <TextBlock DockPanel.Dock="Top" Text="Items" Style="{StaticResource H2}" Margin="0,4,0,4" />
                    <Border DockPanel.Dock="Top" MaxHeight="240" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#EEF2F7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item" FontWeight="SemiBold" Padding="10,7" />
                                <TextBlock Grid.Column="1" Text="Ordered" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="2" Text="Already Sent" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="3" Text="Left to Send" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="4" Text="Send Now (Qty)" FontWeight="SemiBold" Padding="6,7" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Parent item row -->
                                                <Grid Height="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />
                                                    <TextBlock Grid.Column="0" Text="{Binding Description}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Ordered, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Dispatched, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Pending, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                    <TextBox Grid.Column="4" Text="{Binding DispatchQty, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="6,5" VerticalAlignment="Center" />
                                                </Grid>
                                                <!-- Bundled accessories for this item line -->
                                                <ItemsControl ItemsSource="{Binding Accessories}"
                                                              Visibility="{Binding HasAccessories, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="34" Background="#F7FAFC">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="100" />
                                                                    <ColumnDefinition Width="100" />
                                                                    <ColumnDefinition Width="150" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />
                                                                <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" Padding="30,0,0,0"
                                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Ordered, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Dispatched, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Pending, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                                <TextBox Grid.Column="4" Text="{Binding DispatchQty, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="6,4" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="Accessories" Style="{StaticResource H2}" Margin="0,12,0,4" />
                    <Border DockPanel.Dock="Top" MaxHeight="180" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#EEF2F7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Accessory" FontWeight="SemiBold" Padding="10,7" />
                                <TextBlock Grid.Column="1" Text="Ordered" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="2" Text="Already Sent" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="3" Text="Left to Send" FontWeight="SemiBold" Padding="6,7" />
                                <TextBlock Grid.Column="4" Text="Send Now (Qty)" FontWeight="SemiBold" Padding="6,7" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AccessoryLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />
                                                <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" Padding="10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Ordered, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Dispatched, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Pending, StringFormat={}{0:0.###}}" VerticalAlignment="Center" Padding="6,0" />
                                                <TextBox Grid.Column="4" Text="{Binding DispatchQty, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="6,5" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
