<UserControl x:Class="SaniStock.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🏺" FontSize="44" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding AppName}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,8" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource Muted}" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Platform" Style="{StaticResource Muted}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Framework}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Data folder" Style="{StaticResource Muted}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataLocation}" FontFamily="Consolas" Margin="0,4" />
                </Grid>

                <TextBlock Text="Fully offline. Your data never leaves this machine." Style="{StaticResource Muted}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
