<UserControl x:Class="SaniStock.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Orders" Style="{StaticResource H1}" />
            <TextBlock Text="Every order you have taken. Open one to see what stock it is holding, change it while nothing has been sent, or delete it."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" IsSynchronizedWithCurrentItem="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding PartyOptions}" SelectedItem="{Binding PartyFilter}" IsSynchronizedWithCurrentItem="False"
                                  DisplayMemberPath="Name" ToolTip="Leave blank for all customers" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Brand" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding BrandFilter}" IsSynchronizedWithCurrentItem="False"
                                  DisplayMemberPath="Name" ToolTip="Orders with at least one line for this brand" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Clear" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="⟳ Refresh" Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- List on the left, the opened order on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <!-- No two-way SelectedItem binding: the row buttons pass the row as their
                     CommandParameter, so nothing needs it, and a Selector writing its selection
                     back while the screen is torn down on navigation is what crashes WPF's
                     binding engine. -->
                <DataGrid ItemsSource="{Binding Orders}" EnableRowVirtualization="True"
                          IsSynchronizedWithCurrentItem="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="Auto" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=dd-MMM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Party}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
                        <DataGridTextColumn Header="Ordered" Binding="{Binding Ordered, StringFormat={}{0:0.###}}" Width="Auto" />
                        <DataGridTextColumn Header="Left" Binding="{Binding Pending, StringFormat={}{0:0.###}}" Width="Auto" />
                        <DataGridTemplateColumn Header="Actions" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Change the lines. Only while nothing has been sent."
                                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete" FontSize="11" Padding="8,3"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Cancel this order and free the stock it is holding. Nothing is erased."
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Style="{StaticResource H2}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Read-only detail -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                        <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Items" Style="{StaticResource FieldLabel}" />
                            <DataGrid ItemsSource="{Binding DetailLines}" MaxHeight="200" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" />
                                    <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                                    <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="Auto" />
                                    <DataGridTextColumn Header="Ordered" Binding="{Binding Ordered, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Sent" Binding="{Binding Dispatched, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Left" Binding="{Binding Pending, StringFormat={}{0:0.###}}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Where each line's reservation actually sits. This is what explains a
                                 shortfall: the grade/brand holding the stock is not always the one
                                 printed on the line. -->
                            <Expander Header="Stock each line is holding" IsExpanded="False" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding DetailLines}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock FontWeight="SemiBold" FontSize="12">
                                                    <Run Text="{Binding Item}" /><Run Text=" / " /><Run Text="{Binding Grade}" /><Run Text=" / " /><Run Text="{Binding Brand}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sources}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <TextBlock Text="Accessories" Style="{StaticResource FieldLabel}" />
                            <DataGrid ItemsSource="{Binding DetailAccessories}" MaxHeight="150" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Accessory" Binding="{Binding Accessory}" Width="*" />
                                    <DataGridTextColumn Header="With" Binding="{Binding BundledWith}" Width="Auto" />
                                    <DataGridTextColumn Header="Ordered" Binding="{Binding Ordered, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Sent" Binding="{Binding Dispatched, StringFormat={}{0:0.###}}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Dispatches" Style="{StaticResource FieldLabel}" />
                            <DataGrid ItemsSource="{Binding DetailDispatches}" MaxHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Note No" Binding="{Binding DispatchNo}" Width="Auto" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="Auto" />
                                    <!-- Negative on a reversing note: it put goods back rather than sending them. -->
                                    <DataGridTextColumn Header="Qty" Binding="{Binding SignedQuantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                                    <DataGridTextColumn Header="By" Binding="{Binding DispatchedBy}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Undo" Padding="8,3" FontSize="11"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Put these goods back into stock. Only the most recent dispatch can be undone."
                                                        Command="{Binding DataContext.ReverseDispatchCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Edit mode -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Changing this order releases everything it is holding and books it again against today's stock. The order number stays the same."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PartyOptions}" SelectedItem="{Binding EditParty}" IsSynchronizedWithCurrentItem="False"
                                      DisplayMemberPath="Name" Margin="0,0,0,10" />
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EditDate}" Margin="0,0,0,10" />
                            <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditRemarks, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Lines" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding EditLines}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                                      ItemsSource="{Binding DataContext.Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Item}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False" />
                                            <ComboBox Grid.Column="1" Width="70" Margin="0,0,4,0"
                                                      ItemsSource="{Binding DataContext.Grades, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Grade}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False" />
                                            <ComboBox Grid.Column="2" Width="84" Margin="0,0,4,0"
                                                      ItemsSource="{Binding DataContext.Colours, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Colour}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False" />
                                            <ComboBox Grid.Column="3" Width="90" Margin="0,0,4,0"
                                                      ItemsSource="{Binding DataContext.Brands, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Brand}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False" />
                                            <TextBox Grid.Column="4" Margin="0,0,4,0" Tag="Qty"
                                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="5" Content="✕" Padding="8,3" FontSize="11"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.RemoveEditLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="＋ Add line" Command="{Binding AddEditLineCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Padding="10,4" FontSize="12" Margin="0,0,0,12" />

                            <TextBlock Text="Bundled accessories are worked out again from each item's recipe when you save."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="💾  Save changes" Command="{Binding SaveEditCommand}"
                                        Style="{StaticResource PrimaryButton}" Height="38" Width="160" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
