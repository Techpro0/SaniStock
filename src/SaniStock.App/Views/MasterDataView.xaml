<UserControl x:Class="SaniStock.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Reusable "Edit" button column content -->
        <DataTemplate x:Key="EditCell">
            <Button Content="Edit" FontSize="11" Padding="8,3" Style="{StaticResource SecondaryButton}"
                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
        <Style x:Key="FormButtons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Setup Lists" Style="{StaticResource H1}" />
            <TextBlock Text="Add your items, colours, customers and other lists here before taking orders." Style="{StaticResource Muted}" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Items -->
            <TabItem Header="Items" DataContext="{Binding ItemsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Item" Style="{StaticResource H2}" />
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Grades -->
            <TabItem Header="Grades" DataContext="{Binding GradesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Grade" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Sort Order" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.SortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Colours -->
            <TabItem Header="Colours" DataContext="{Binding ColoursTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Hex" Binding="{Binding HexCode}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Colour" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Hex Code (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.HexCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Accessories -->
            <TabItem Header="Accessories" DataContext="{Binding AccessoriesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Accessory" Style="{StaticResource H2}" />
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Parties -->
            <TabItem Header="Customers" DataContext="{Binding PartiesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="Auto" />
                            <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Customer Details" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                                     AcceptsReturn="True" Height="52" TextWrapping="Wrap" />
                            <TextBlock Text="Contact" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Contact, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="GSTIN" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Gstin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Raw materials -->
            <TabItem Header="Raw Materials" DataContext="{Binding RawMaterialsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                            <DataGridTemplateColumn Width="70" CellTemplate="{StaticResource EditCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Raw Material" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
