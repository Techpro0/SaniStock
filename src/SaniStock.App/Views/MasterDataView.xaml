<UserControl x:Class="SaniStock.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Row actions shared by every tab. Delete and Restore swap places on the same row:
             a record is never removed, only switched off, so the two are one toggle. -->
        <DataTemplate x:Key="RowActionsCell">
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" />
                <Button Content="Delete" FontSize="11" Padding="8,3"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                        ToolTip="Stop offering this in the lists. Nothing is erased and you can restore it."
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" />
                <Button Content="Restore" FontSize="11" Padding="8,3"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisInverse}}"
                        ToolTip="Put this back into use."
                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!-- "Active / Deleted" status text, so a deleted row reads as deleted rather than as an
             unticked checkbox the user cannot click (the grids are read-only). -->
        <DataTemplate x:Key="StatusCell">
            <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActive}}"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="#C62828" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Sits above each grid; bound to the tab's own MasterList. -->
        <DataTemplate x:Key="ShowDeletedToggle">
            <CheckBox Content="Show deleted" IsChecked="{Binding ShowInactive}"
                      VerticalAlignment="Center" Margin="0,0,0,8" />
        </DataTemplate>

        <Style x:Key="FormButtons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Setup Lists" Style="{StaticResource H1}" />
            <TextBlock Text="Add your items, colours, customers and other lists here before taking orders." Style="{StaticResource Muted}" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Product Types (sits above Items in the hierarchy) -->
            <TabItem Header="Product Type" DataContext="{Binding ProductTypesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Product Type" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Items -->
            <TabItem Header="Items" DataContext="{Binding ItemsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding ProductType.Name}" Width="Auto" />
                                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Item" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Product Type" Style="{StaticResource FieldLabel}" />
                            <ComboBox Margin="0,0,0,10"
                                      ItemsSource="{Binding DataContext.ProductTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding Editing.ProductTypeId}" SelectedValuePath="Id"
                                      DisplayMemberPath="Name" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />

                            <!-- Default accessories (bundling recipe). Bound to the parent view model. -->
                            <CheckBox Content="Include Accessories by default" Margin="0,14,0,0"
                                      IsChecked="{Binding DataContext.IncludeAccessoriesByDefault, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Border Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding DataContext.IncludeAccessoriesByDefault, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Background="#EEF2F7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Accessory" FontWeight="SemiBold" FontSize="11" Padding="4,5" />
                                        <TextBlock Grid.Column="2" Text="Qty/Unit" FontWeight="SemiBold" FontSize="11" Padding="4,5" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DataContext.AccessoryDefaults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Padding="4,0" />
                                                        <TextBox Grid.Column="2" Text="{Binding QtyPerUnit, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsSelected}" Margin="2,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Grades -->
            <TabItem Header="Grades" DataContext="{Binding GradesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Grade" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Sort Order" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.SortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Colours -->
            <TabItem Header="Colours" DataContext="{Binding ColoursTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexCode}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Colour" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Hex Code (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.HexCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Brands: assigned at packing, ordered against. Deactivate rather than delete, like
                 every other list here — packed stock and old orders still point at them. -->
            <TabItem Header="Brands" DataContext="{Binding BrandsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Brand" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <TextBlock Text="Turning a brand off hides it from Packing and New Order. Stock already packed under it stays visible on the Stock screen until it is sold."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Accessories -->
            <TabItem Header="Accessories" DataContext="{Binding AccessoriesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Accessory" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Parties -->
            <TabItem Header="Customers" DataContext="{Binding PartiesTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="Auto" />
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Customer Details" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                                     AcceptsReturn="True" Height="52" TextWrapping="Wrap" />
                            <TextBlock Text="Contact" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Contact, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="GSTIN" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Gstin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Raw materials -->
            <TabItem Header="Raw Materials" DataContext="{Binding RawMaterialsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource ShowDeletedToggle}" Content="{Binding}" />
                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="Auto" />
                                <DataGridTemplateColumn Header="Status" Width="Auto" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTemplateColumn Header="Actions" Width="150" CellTemplate="{StaticResource RowActionsCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Edit Raw Material" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Unit (PCS, KG…)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editing.UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                            <StackPanel Style="{StaticResource FormButtons}">
                                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
