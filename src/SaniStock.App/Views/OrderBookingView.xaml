<UserControl x:Class="SaniStock.App.Views.OrderBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="New Order" Style="{StaticResource H1}" />
            <TextBlock Text="Pick the customer, add the items they want, then press Save Order." Style="{StaticResource Muted}" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Parties}" SelectedItem="{Binding Party}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding OrderDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lines -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Finished lines -->
            <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Items" Style="{StaticResource H2}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding NewItem}"
                                  DisplayMemberPath="Name" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" Width="80" ItemsSource="{Binding Grades}" SelectedItem="{Binding NewGrade}"
                                  DisplayMemberPath="Name" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="2" Width="90" ItemsSource="{Binding Colours}" SelectedItem="{Binding NewColour}"
                                  DisplayMemberPath="Name" Margin="0,0,6,0" />
                        <TextBox Grid.Column="3" Text="{Binding NewQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <Button Grid.Column="4" Content="Add" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding Lines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" FontSize="11" Padding="6,2" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Accessory lines -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Accessories" Style="{StaticResource H2}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Accessories}" SelectedItem="{Binding NewAccessory}"
                                  DisplayMemberPath="Name" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding NewAccessoryQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Add" Command="{Binding AddAccessoryLineCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding AccessoryLines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Accessory" Binding="{Binding Accessory}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" FontSize="11" Padding="6,2" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.RemoveAccessoryLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions + recent -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="✅  Save Order" Command="{Binding BookCommand}"
                    Style="{StaticResource PrimaryButton}" Height="46" Width="180" FontSize="15" VerticalAlignment="Bottom" />
            <Expander Header="Recent Orders" IsExpanded="False">
                <DataGrid ItemsSource="{Binding RecentOrders}" MaxHeight="180" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="Auto" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=dd-MMM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Party}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </DockPanel>
    </Grid>
</UserControl>
