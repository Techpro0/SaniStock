<UserControl x:Class="SaniStock.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource H1}" Margin="0,0,0,12" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Stock -->
            <TabItem Header="Stock">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Show" Command="{Binding RunStockCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="🖨 Save PDF" Command="{Binding StockPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="📄 Save Excel" Command="{Binding StockExcelCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding StockRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                            <DataGridTextColumn Header="In Stock" Binding="{Binding OnHand, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Booked" Binding="{Binding Reserved, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Free" Binding="{Binding Available, StringFormat={}{0:0.###}}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Shortfall -->
            <TabItem Header="What to Make">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Show" Command="{Binding RunShortfallCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="🖨 Save PDF" Command="{Binding ShortfallPdfCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ShortfallRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                            <DataGridTextColumn Header="In Stock" Binding="{Binding OnHand, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Booked" Binding="{Binding Reserved, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Make Qty" Binding="{Binding Shortfall, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Orders Waiting" Binding="{Binding Drivers.Count}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Production -->
            <TabItem Header="Production">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="From Date" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,10,0" />
                        <TextBlock Text="To Date" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,10,0" />
                        <ComboBox Width="180" ItemsSource="{Binding Items}" SelectedItem="{Binding Item}"
                                  DisplayMemberPath="Name" Margin="0,0,10,0" />
                        <Button Content="Show" Command="{Binding RunProductionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="🖨 Save PDF" Command="{Binding ProductionPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="📄 Save Excel" Command="{Binding ProductionExcelCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ProductionRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="Auto" />
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Reversal" Binding="{Binding IsReversal}" Width="Auto" />
                            <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Orders -->
            <TabItem Header="Orders">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="From Date" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,10,0" />
                        <TextBlock Text="To Date" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,10,0" />
                        <ComboBox Width="180" ItemsSource="{Binding Parties}" SelectedItem="{Binding Party}"
                                  DisplayMemberPath="Name" Margin="0,0,10,0" />
                        <Button Content="Show" Command="{Binding RunOrdersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="🖨 Save PDF" Command="{Binding OrdersPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="📄 Save Excel" Command="{Binding OrdersExcelCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding OrderRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="Auto" />
                            <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=dd-MMM-yyyy}" Width="Auto" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding Party}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Item / Accessory" Binding="{Binding ItemOrAccessory}" Width="*" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="Auto" />
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="Auto" />
                            <DataGridTextColumn Header="Ordered" Binding="{Binding Ordered, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding Dispatched, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Left" Binding="{Binding Pending, StringFormat={}{0:0.###}}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
